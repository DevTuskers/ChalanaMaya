{
  "name": "chalanamaya",
  "private": true,
  "version": "0.1.0",
  "description": "ChalanaMaya — a hand-drawn-style infinite whiteboard.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude ./data server/main.ts --dev",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build && vite build --ssr -c vite.server.config.ts",
    "start": "node dist-server/main.js",
    "preview": "vite preview",
    "db:smoke": "tsx server/db/smokeCli.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:app": "vitest run --project app",
    "test:server": "vitest run --project server",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "12.11.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "fractional-indexing": "^3.4.0",
    "image-size": "^2.1.0",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "roughjs": "^4.6.6",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
